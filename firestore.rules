rules_version = '2';

// Reglas de Cloud Firestore para el anotador de la arteria braquial.
//
// Colecciones:
//   anotadores/{correo}   Lista blanca. Un documento (vacío) por persona autorizada, con su correo
//                         de Google como ID. Se crean a mano en la consola de Firebase.
//   videos/{video}        Datos de cada video (n_frames, fps, tamaño...). Los escribe
//                         scripts/preparar_frames.py con credenciales de administrador.
//   anotaciones/{id}      Una por (video, frame, persona); id = "<video>__<frame>__<uid>".
//                         Cada persona solo puede leer y escribir las suyas.
service cloud.firestore {
  match /databases/{database}/documents {

    function autorizado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/anotadores/$(request.auth.token.email));
    }

    // Una línea: {altura, anclas:[{x, dy}, ...]} (se valida el tamaño; el contenido lo arma la app).
    function lineasValidas(lineas) {
      return lineas is list && lineas.size() <= 20;
    }

    match /anotadores/{correo} {
      // Cada quien puede consultar si está en la lista (para mostrarle un mensaje claro).
      allow read: if request.auth != null && request.auth.token.email == correo;
      allow write: if false;
    }

    match /videos/{video} {
      allow read: if autorizado();
      allow write: if false;
    }

    match /anotaciones/{id} {
      allow read, delete: if autorizado() && resource.data.uid == request.auth.uid;

      allow create, update: if autorizado()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && id == request.resource.data.video + '__' + string(request.resource.data.frame)
                 + '__' + request.auth.uid
        && request.resource.data.frame is int
        && request.resource.data.frame >= 0
        && exists(/databases/$(database)/documents/videos/$(request.resource.data.video))
        && lineasValidas(request.resource.data.lineas)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'nombre', 'video', 'frame',
             'ancho', 'alto', 'lineas', 'formato', 'actualizado']);
    }
  }
}
